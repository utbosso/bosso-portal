# Development Supabase project. Public client credentials are not admin credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-client-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Never prefix a privileged key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-key
SUPABASE_URL=https://your-project.supabase.co

# Optional integrations: configure only when developing those workflows.
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
# GMAIL_SMTP_USER=
# GMAIL_SMTP_APP_PASSWORD=
# EMAIL_FROM_NAME=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# GOOGLE_CALENDAR_ID=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
